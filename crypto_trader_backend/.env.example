# ============================================================================
# CryptoTrader backend configuration — copy to `.env` and edit.
#   cp .env.example .env
# Everything below has a working default; production needs the marked lines.
# ============================================================================

ENV=production                      # dev | staging | production
DEMO_MODE=true                      # true => built-in market simulator, no Binance calls
DEBUG=false

# --- server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","https://app.your-domain.com"]
PUBLIC_BASE_URL=https://api.your-domain.com

# --- database --------------------------------------------------------------
# SQLite is the default and needs zero setup; Postgres for anything shared.
DB_URL=sqlite+aiosqlite:///data/cryptotrader.db
# DB_URL=postgresql+asyncpg://cryptotrader:cryptotrader@db:5432/cryptotrader
DB_ECHO=false

# --- secrets (REQUIRED in production; generate with `openssl rand -hex 32`) -
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
DATA_ENCRYPTION_KEY=                # optional 32-byte key (base64) for the local AES-GCM vault
CREDENTIAL_FINGERPRINT_SALT=CHANGE_ME_TOO

# --- bootstrap admin (first run only) --------------------------------------
AUTO_CREATE_ADMIN=true
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=ChangeMe-Right-Now-1!

# --- Binance ---------------------------------------------------------------
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
BINANCE_WS_URL=wss://stream.binance.com:9443
REQUEST_WEIGHT_BUDGET=5400          # Binance gives 6000/min; we stay under
REQUEST_TIMEOUT_S=12
MAX_RETRIES=3
MARKETS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,LINKUSDT,AVAXUSDT,TONUSDT
KLINE_INTERVALS=1m,5m,15m,1h,4h,1d

# --- risk limits (also enforceable per user in the DB) ---------------------
MAX_TRADE_NOTIONAL_USD=2500
MAX_TRADE_PCT_OF_BALANCE=25
MIN_ORDER_NOTIONAL_USD=10
MAX_OPEN_POSITIONS=10
DAILY_LOSS_LIMIT_USD=500
TRADE_COOLDOWN_S=5
KILL_SWITCH=false

# --- AI --------------------------------------------------------------------
AI_LOOKBACK=120
AI_HORIZON=12
AI_MIN_CONFIDENCE=0.60
AI_RETRAIN_DAYS=7
AI_RETRAIN_INTERVAL_HOURS=6
AI_MODEL_DIR=app/ai/artifacts
AI_AUTO_EXECUTE=false               # true => the autopilot may place orders unattended

# --- auto-trader -----------------------------------------------------------
AUTO_TRADE_ENABLED=false
AUTO_TRADE_INTERVAL_S=300
AUTO_TRADE_SYMBOLS=BTCUSDT,ETHUSDT
AUTO_TRADE_MAX_CONCURRENT=3

# --- alerts / notifications -------------------------------------------------
ALERT_SCAN_INTERVAL_S=5
FCM_SERVICE_ACCOUNT_JSON=           # path or raw JSON (optional)
FCM_PROJECT_ID=
FIRESTORE_ENABLED=false

# --- security --------------------------------------------------------------
KEY_VAULT_PROVIDER=local            # local | vault | aws_kms
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_TRANSIT_KEY=cryptotrader
AWS_KMS_KEY_ID=
PLAY_INTEGRITY_MODE=disabled        # disabled | jwt | google
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
PLAY_INTEGRITY_PACKAGE_NAME=com.ai.cryptotrader
REQUIRE_ENVELOPE_FOR_KEYS=false     # true in production => only encrypted key uploads
TOTP_ISSUER=CryptoTrader

# --- google / firebase (optional) ------------------------------------------
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
FIREBASE_PROJECT_ID=

# --- observability ---------------------------------------------------------
TELEMETRY_ENABLED=true
METRICS_TOKEN=
LOG_LEVEL=INFO
