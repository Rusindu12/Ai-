# Root compose file convenience env. The real list of options with comments is
# in crypto_trader_backend/.env.example — copy that file to
# crypto_trader_backend/.env and it will be used by `docker compose`.
#
# Quick start:
#   cp crypto_trader_backend/.env.example crypto_trader_backend/.env
#   docker compose up --build

# --- backend ---
ENV=production
DEMO_MODE=true
JWT_SECRET=please-replace-me-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=Admin-1234-CHANGE
MARKETS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT

# --- flutter app build-time config (dart-define) ---
API_BASE_URL=http://10.0.2.2:8000
WS_BASE_URL=
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=
PIN_SHA256=
AUTO_LOGOUT_SECONDS=900
