# ============================================================
#  AI Crypto Trading Platform — environment configuration
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---------- Backend (Node.js) ----------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Database ----------
# PostgreSQL connection string. Leave empty to fall back to an in-memory store (dev only).
DATABASE_URL=postgres://user:password@localhost:5432/trading
# Redis URL. Leave empty to fall back to an in-memory cache (dev only).
REDIS_URL=redis://localhost:6379

# ---------- Binance ----------
# Set BINANCE_TESTNET=true to use the Binance Spot Testnet (paper keys).
BINANCE_TESTNET=false
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
# Comma-separated IPs allowed to call signed Binance endpoints from our side (outbound safeguard)
BINANCE_IP_WHITELIST=
# 1200 request-weights per minute is Binance's default limit
BINANCE_RATE_LIMIT=1200
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

# ---------- AI service (Python) ----------
AI_SERVICE_URL=http://localhost:8000
# Retrain the models on this cron schedule (cron expression)
AI_RETRAIN_CRON=0 2 * * *
# Used to seed the deterministic demo model / backtests
AI_RANDOM_SEED=42

# ---------- Risk management defaults ----------
RISK_MAX_POSITION_PCT=0.05
RISK_MAX_PORTFOLIO_PCT=0.10
RISK_DAILY_LOSS_LIMIT_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.20
RISK_VOLATILITY_LOOKBACK=20
RISK_VOLATILITY_TARGET=0.01
RISK_MAX_OPEN_POSITIONS=5

# ---------- Alerts ----------
# Telegram bot (https://core.telegram.org/bots)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord webhook URL
DISCORD_WEBHOOK_URL=
# SMTP for email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---------- Encryption ----------
# 32-byte key encoded as base64/hex for AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-32-byte-key

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
