+  .card.mt{margin-top:0}
+  #mList{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:10px}
+  .toasts{bottom:24px}
+}
+@media (min-width:1600px){
+  #t-signals.on,#t-bot.on,#t-sys.on{column-count:3}
+  #mList{grid-template-columns:repeat(3,minmax(0,1fr))}
+}
 </style>
